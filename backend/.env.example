PORT=5000
NODE_ENV=production
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/shortdoc_db?schema=public"
JWT_SECRET="generate_a_random_64_character_secret_key_for_production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25

# Seed sozlamalari (ixtiyoriy, agar ko'rsatilsa CLI seed parollarni o'rnatadi)
# SEED_ALLOW=true
# SEED_ADMIN_PASSWORD=strong_admin_password
