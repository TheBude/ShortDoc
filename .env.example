# Environment Configuration for ShortDoc
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/shortdoc_db?schema=public

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_university_2026_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
