# ==========================================
# ShortDoc University Document Management System
# Production Environment Variables Template
# ==========================================

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_strong_password_in_production
POSTGRES_DB=shortdoc_db
DATABASE_URL=postgresql://postgres:change_this_strong_password_in_production@localhost:5432/shortdoc_db?schema=public

# Backend API Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=generate_a_random_64_char_secret_key_for_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Seed Configuration (CLI only: npm run seed)
# Productionda seed qilish uchun SEED_ALLOW=true bo'lishi shart
# SEED_ALLOW=true
# SEED_ADMIN_PASSWORD=your_strong_admin_password

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
BACKEND_INTERNAL_URL=http://localhost:5000
